// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Inc16(in=regOut, out=incremented);
    
    Mux16(a=in, b=incremented, sel=inc, out=inOrInc);
    Mux16(a=incremented, b=in, sel=load, out=loadInOrInc);
    Mux16(a=loadInOrInc, b=false, sel=reset, out=newValue);

    Or(a=reset, b=load, out=resetOrLoad);
    Or(a=resetOrLoad, b=inc, out=resetOrLoadOrInc);

    Register(in=newValue, load=resetOrLoadOrInc, out=regOut, out=out);
}